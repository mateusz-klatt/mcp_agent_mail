OPENAI_API_KEY=sk-proj-...
GEMINI_API_KEY=AIza...
ANTHROPIC_API_KEY=sk-ant-...
DEEPSEEK_API_KEY=sk-a...
OPENROUTER_API_KEY=sk-or-v1-3...
GROK_API_KEY=xai-US...
LLM_CACHE_BACKEND=redis
LLM_CACHE_REDIS_URL=redis://hostname:6379/0
WORKTREES_ENABLED=0

# HTTP transport
HTTP_HOST=127.0.0.1
HTTP_PORT=8765
HTTP_PATH=/api/
# Comma-separated proxy IPs/networks whose X-Forwarded-Proto/For Uvicorn may
# trust. Keep the localhost default unless a sanitizing reverse proxy is the
# only ingress; use "*" only when every backend peer is trusted.
HTTP_FORWARDED_ALLOW_IPS=127.0.0.1
# Direct `uvicorn ... --factory` reads Uvicorn's standard variable instead.
# Keep the two values identical when using that lower-level entrypoint.
# FORWARDED_ALLOW_IPS=127.0.0.1
HTTP_BEARER_TOKEN=

# Optional browser OAuth broker for remote MCP clients such as VS Code.
# Create one GitHub OAuth App whose callback is:
#   <HTTP_OAUTH_BASE_URL>/auth/callback
# Keep HTTP_OAUTH_BASE_URL to the public origin only (no /mcp path).
# Prefer immutable GitHub IDs in the allowlist (`gh api user --jq .id`).
HTTP_OAUTH_ENABLED=false
HTTP_OAUTH_BASE_URL=https://mail.example.com
HTTP_OAUTH_GITHUB_CLIENT_ID=
HTTP_OAUTH_GITHUB_CLIENT_SECRET=
HTTP_OAUTH_GITHUB_ALLOWED_IDENTITIES=id:123456
# Cache successful GitHub identity checks briefly. Revocation propagates after
# at most this many seconds; 0 disables caching and increases GitHub API load.
HTTP_OAUTH_GITHUB_TOKEN_CACHE_TTL_SECONDS=60
# Separate low-rate bucket for anonymous dynamic client registrations.
HTTP_OAUTH_DCR_RATE_LIMIT_PER_MINUTE=10
# Stable secret used for local JWT signing and encrypted OAuth state.
# Generate with: openssl rand -hex 32
HTTP_OAUTH_JWT_SIGNING_KEY=
HTTP_OAUTH_STORAGE_PATH=~/.mcp_agent_mail_oauth
HTTP_OAUTH_ACCESS_TOKEN_TTL_SECONDS=2592000
HTTP_OAUTH_ALLOWED_CLIENT_REDIRECT_URIS=http://127.0.0.1:*,http://127.0.0.1/,https://vscode.dev/redirect,https://insiders.vscode.dev/redirect
HTTP_OAUTH_RBAC_ROLE=writer

# Signs the /mail viewer's login cookie. REQUIRED if you want to open /mail at all.
#
# MAIL_UI_AUTH_ENABLED defaults to true and this defaults to empty, so the two
# defaults together mean a fresh install answers EVERY /mail route with
#
#   503  {"detail": "Mail UI authentication is unconfigured (MAIL_UI_SESSION_SECRET is empty)."}
#
# That is deliberate — the viewer has destructive routes and serving them
# unauthenticated is never the safer default — but from the outside it reads as a
# broken deployment rather than a decision waiting on one variable. Bisected to
# 03a7638 by home-win-1 after it cost the four of us an afternoon of measuring.
#
# Any long random string works; it is never sent to the browser, only used to sign.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Set MAIL_UI_AUTH_ENABLED=false only for isolated test/development instances.
# Disabling it also disables the viewer's per-project authorization boundary.
# HTTP_BEARER_TOKEN is an MCP/service credential, not a human viewer login: when
# UI auth is enabled it cannot open /mail pages or APIs. The sole exception is
# GET /mail/api/file-reservations?project=..., retained for installed hooks.
# Bootstrap the first human admin explicitly:
#   mcp-agent-mail ui-users add <name> --role admin
MAIL_UI_AUTH_ENABLED=true
MAIL_UI_SESSION_SECRET=

# Production startup requires rate limiting when HTTP_OAUTH_ENABLED=true,
# because DCR and the browser endpoints are intentionally public. DCR is also
# capped at 8 KiB/request and stored separately from issued tokens.
HTTP_RATE_LIMIT_ENABLED=false
HTTP_RATE_LIMIT_PER_MINUTE=60
HTTP_REQUEST_LOG_ENABLED=false
TOOLS_LOG_ENABLED=false
HTTP_OTEL_ENABLED=false
OTEL_SERVICE_NAME=mcp-agent-mail
OTEL_EXPORTER_OTLP_ENDPOINT=

# Database
DATABASE_URL=sqlite+aiosqlite:///./storage.sqlite3
DATABASE_ECHO=false

# Storage / Git authoring
STORAGE_ROOT=~/.mcp_agent_mail_git_mailbox_repo
GIT_AUTHOR_NAME=mcp-agent
GIT_AUTHOR_EMAIL=mcp-agent@example.com

# Attachments / images
INLINE_IMAGE_MAX_BYTES=65536
CONVERT_IMAGES=true
KEEP_ORIGINAL_IMAGES=false
ALLOW_ABSOLUTE_ATTACHMENT_PATHS=false

# CORS (HTTP app)
HTTP_CORS_ENABLED=false
HTTP_CORS_ORIGINS=
HTTP_CORS_ALLOW_CREDENTIALS=false
HTTP_CORS_ALLOW_METHODS=*
HTTP_CORS_ALLOW_HEADERS=*

# Background maintenance (file reservations cleanup)
FILE_RESERVATIONS_CLEANUP_ENABLED=false
FILE_RESERVATIONS_CLEANUP_INTERVAL_SECONDS=60

# Message Quotas
QUOTA_ENABLED=true
QUOTA_ATTACHMENTS_LIMIT_BYTES=500000000
QUOTA_INBOX_LIMIT_COUNT=10000
RETENTION_REPORT_ENABLED=true

CONTACT_AUTO_RETRY_ENABLED=true
